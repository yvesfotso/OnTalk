# ---------------------------------------------------------------------------
# OnTalk environment variables
#
# Copy this file to .env.local and fill in real values:
#   cp .env.example .env.local
#
# .env.local is gitignored. Never commit real credentials.
# ---------------------------------------------------------------------------

# --- Supabase --------------------------------------------------------------
# Supabase dashboard → your project → Project Settings → API
#
#   NEXT_PUBLIC_SUPABASE_URL      "Project URL"
#   NEXT_PUBLIC_SUPABASE_ANON_KEY "anon" / "publishable" key
#
# Both are safe to expose in the browser: every table is protected by Row Level
# Security. This app never uses the service_role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- AI tutor --------------------------------------------------------------
# Any OpenAI-compatible /chat/completions endpoint works.
#
#   OpenAI     AI_BASE_URL=https://api.openai.com/v1    AI_MODEL=gpt-4o-mini
#   Groq       AI_BASE_URL=https://api.groq.com/openai/v1
#   Together   AI_BASE_URL=https://api.together.xyz/v1
#   Ollama     AI_BASE_URL=http://localhost:11434/v1    AI_API_KEY=ollama
#
# AI_API_KEY is server-only — it must NOT be prefixed with NEXT_PUBLIC_.
# Without it the app still runs; the tutor shows a "not configured" notice.
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# --- Site ------------------------------------------------------------------
# Used for password-reset links and SEO metadata. Set to your deployed origin
# in production, e.g. https://ontalk.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Demo account script (do NOT add here) ----------------------------------
# `npm run demo:create` (scripts/create-demo-user.mjs) needs SUPABASE_SERVICE_ROLE_KEY,
# from Project Settings → API → service_role. Pass it inline on the command line
# instead of storing it in this file — it's an admin credential the app itself
# never uses, and keeping it out of .env.local means it never leaks into a
# process that doesn't need it:
#   SUPABASE_SERVICE_ROLE_KEY=eyJ... npm run demo:create
